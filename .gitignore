# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.so

# Virtual envs
.venv/
venv/
env/

# Data & artifacts (large) — the whole data/ tree is downloaded/generated
/data/
*.zip
checkpoints/*.pt
checkpoints/*.ckpt
runs/
outputs/
reports/*.html
reports/*.png
*.vtk
*.vtu

# Run logs (live training stdout + GPU monitor) + dashboard control flag —
# regenerable, never committed.
*.log
run_control.json

# LaTeX build artifacts (the .tex/.bib/.sty/.bbl/.pdf ARE committed; the rest
# are regenerable scratch from pdflatex/bibtex/latexmk).
*.aux
*.blg
*.out
*.fls
*.fdb_latexmk
*.toc
*.synctex.gz

# Keep small bundled demo assets
!assets/**

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Experiment results ARE committed (small tables / figures / manifests are
# pushed back from the PC); keep only the large binaries out of them.
results/**/*.pt
results/**/*.ckpt
# Smoke-test artifacts (tiny validation runs) are not real results.
results/*_smoke/
results/**/_smoke/
