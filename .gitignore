# Keep small bundled demo assets
!assets/**

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Experiment results ARE committed (small tables / figures / manifests are
# pushed back from the PC); keep only the large binaries out of them.
results/**/*.pt
results/**/*.ckpt
