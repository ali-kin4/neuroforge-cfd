# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.so

# Virtual envs
.venv/
venv/
env/

# Data & artifacts (large) — the whole data/ tree is downloaded/generated
/data/
*.zip
checkpoints/*.pt
checkpoints/*.ckpt
checkpoints/**/*.pt
checkpoints/**/*.ckpt
checkpoints/**/*.done
checkpoints/**/*.tmp
runs/
outputs/
reports/*.html
reports/*.png
*.vtk
*.vtu

# Run logs (live training stdout + GPU monitor) + dashboard control flag —
# regenerable, never committed.
*.log
run_control.json

# LaTeX build artifacts (the .tex/.bib/.sty/.bbl/.pdf ARE committed; the rest
# are regenerable scratch from pdflatex/bibtex/latexmk).
*.aux
*.blg
*.out
*.fls
*.fdb_latexmk
*.toc
*.synctex.gz

# Keep small bundled demo assets
!assets/**

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Experiment results ARE committed (small tables / figures / manifests are
# pushed back from the PC); keep only the large binaries out of them.
results/**/*.pt
results/**/*.ckpt
# Smoke-test artifacts (tiny validation runs) are not real results.
results/*_smoke/
results/**/_smoke/

# LaTeX spell-check aux
*.spl

# machine-specific wall-clock journal (see measure_inference_cost.py):
# replaying it on other hardware would report this machine timings as yours
results/control/_cache/inference_cost_progress.jsonl

# Paper-2 PDF build scratch (the .md is the source; the PDF is committed)
docs/paper2/_build/

# Internal submission and review notes (venue history, reviewer strategy, cover
# letters, personal details). They stay on the author's machine and are never
# published; everything the paper's claims rest on is tracked elsewhere.
docs/paper/submission/*
!docs/paper/submission/highlights.txt
!docs/paper/submission/arxiv_v5/
docs/paper/submission/arxiv_v5/arxiv_v5_metadata.txt
docs/paper2/review/meta_decision.md
docs/paper/review/FINDINGS.md
docs/paper/review/REFRAME_PLAN.md
docs/paper/review/RESOLUTION.md
docs/paper/review/bibliography_audit.md
docs/paper/review/consistency_audit.md
docs/paper/review/domain_expert.md
docs/paper/review/field_scan_sept2026.md
docs/paper/review/idea_portfolio.md
docs/paper/review/journal_shortlist.md
docs/paper/review/novelty_hunt.md
docs/paper/review/r2_holes.md
docs/paper/review/r2_round2.md
docs/paper/review/r2_round3.md
docs/paper/review/r2_round4.md
docs/paper/review/strongest_design.md
docs/paper/review/theorem_audit.md
docs/paper/review/theorem_targets.md
docs/paper/review/venue_plan.md
docs/paper/review/venue_taste.md
